   "source": [
    "Q.2. Write code to replace the odd numbers by -1 in the array created by using random.randint(1,50,20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "4ac59e1a-83a2-4a38-8445-f02f2eb7496f",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1e68a23f-fece-4182-94f4-8857356ab03e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([ 9, 17, 30, 44, 45, 10,  9, 33, 30, 39, 31,  5,  4,  4, 47, 21, 39,\n",
       "       35, 38, 13], dtype=int32)"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr = np.random.randint(1,50,20)\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "ef272aa2-3281-4b83-a2b3-a95dbd25b6c1",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([-1, -1, 30, 44, -1, 10, -1, -1, 30, -1, -1, -1,  4,  4, -1, -1, -1,\n",
       "       -1, 38, -1], dtype=int32)"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr[arr % 2 != 0]= -1\n",
    "arr"
   ]
  },
