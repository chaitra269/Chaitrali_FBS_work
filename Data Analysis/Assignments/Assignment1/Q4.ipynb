   "source": [
    "Q.4. Find out the indices of non zero element in given array\n",
    "[1,2,0,0,4,0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f724d46d-8e74-4fd8-a2d4-b47216aa6b96",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "31f7b0d1-51b7-421b-91b7-b93729aaf4fb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([1, 2, 0, 0, 4, 0])"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr=np.array([1,2,0,0,4,0])\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e82143f8-b7ba-4172-97fe-69cdc371179a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([0, 1, 4])"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr_ind=np.nonzero(arr)[0]\n",
    "arr_ind"
   ]
  },
